@model IEnumerable<Cyber_Protect.Models.Employee>

@{
    ViewData["Title"] = "Analysts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-semibold mb-0">Analysts</h4>
    <a asp-action="Create" class="btn-cp-primary">
        <i class="fa-solid fa-plus"></i> Add Analyst
    </a>
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-users-gear me-1"></i> All Analysts
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                 
                    <th>Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model)
                {
                    <tr>
                       
                        <td>@Html.DisplayFor(modelItem => employee.Analyst)</td>

                        <td>@Html.DisplayFor(modelItem => employee.Email)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@employee.EmployeeID">Edit</a>
                            <a asp-action="Details" asp-route-id="@employee.EmployeeID">Details</a>
                            <a asp-action="Delete" asp-route-id="@employee.EmployeeID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>