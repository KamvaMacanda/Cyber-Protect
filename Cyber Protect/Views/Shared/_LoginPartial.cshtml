@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager?.IsSignedIn(User) == true)
{
    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
        <span class="me-2">Hello @User.Identity?.Name!</span>
        <button type="submit" class="btn btn-link p-0">Logout</button>
    </form>
}
else
{
    <a class="nav-link d-inline me-2" asp-area="Identity" asp-page="/Account/Register">Register</a>
    <a class="nav-link d-inline" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
