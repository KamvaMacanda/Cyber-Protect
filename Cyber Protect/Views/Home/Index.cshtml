@{
    ViewData["Title"] = "Home Page";
}

<div data-aos="fade-up">
    <h1 class="display-4 fw-bold mb-3">
        <i class="fa-solid fa-calendar-star me-2" style="color: var(--accent);"></i>
        Cyber Protect 
    </h1>
    <p class="lead mb-4" style="color: var(--muted);">
        We are a centralized cybersecurity management platform to help you manage incidents , threats 
    </p>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Incidents" asp-action="Index" class="btn btn-success btn-lg">
            <i class="fa-solid fa-tent me-2"></i>View incidents
        </a>
        <a asp-controller="Threats" asp-action="Index" class="btn btn-outline-light btn-lg">
            <i class="fa-solid fa-calendar-days me-2"></i>Views Threats 
        </a>
    </div>
</div>
</div>
