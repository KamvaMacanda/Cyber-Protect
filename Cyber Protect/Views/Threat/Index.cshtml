@model IEnumerable<Cyber_Protect.Models.Threat>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.level)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Severity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Incidents)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.level)
            </td>
            <td>
                @Html.DisplayFor(model => item.Severity)
            </td>
            <td>
                @Html.DisplayFor(model => item.Incidents)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ThreatID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ThreatID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ThreatID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
