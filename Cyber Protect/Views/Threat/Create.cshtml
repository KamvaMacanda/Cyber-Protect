@model Cyber_Protect.Models.Threat

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Threat</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="level" class="control-label">Analyst Risk Assessment</label>
                <input asp-for="level" class="form-control" />
                <span asp-validation-for="level" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Severity" class="control-label">Threat</label>
                <input asp-for="Severity" class="form-control" />
                <span asp-validation-for="Severity" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="DateLogged" class="control-label"></label>
                <input asp-for="DateLogged" class="form-control" />
                <span asp-validation-for="DateLogged" class="text-danger"></span>
            </div>

      

          

            <div class="form-group">
                <label asp-for="Report" class="control-label"></label>
                <input asp-for="Report" class="form-control" />
                <span asp-validation-for="Report" class="text-danger"></span>
            </div>

           
            <button type="submit" class="btn btn-primary">Log Threat</button>

             
            

           
            <a asp-action="Index" class="btn btn-secondary">Back</a>

        </form>
    </div>
</div>


